# Variáveis do Docker Compose (docker-compose.yml e docker-compose.prod.yml).
# Copie para .env na raiz e ajuste. O .env não é versionado: nunca commite segredos reais.
# Para rodar SEM Docker, o arquivo usado é o backend/.env (veja backend/.env.example).

# --- Banco de dados (container PostgreSQL) ---
POSTGRES_USER=moedy
POSTGRES_PASSWORD=moedy
POSTGRES_DB=moedy

# --- Portas na sua máquina ---
DB_PORT=5433
BACKEND_PORT=3333
FRONTEND_PORT=5173
# Porta do frontend nas imagens de produção (docker-compose.prod.yml)
FRONTEND_PORT_PROD=8080

# --- Backend ---
# Obrigatório, com no mínimo 32 caracteres. Gere o seu com: openssl rand -base64 48
# O valor de exemplo abaixo serve no desenvolvimento, mas é RECUSADO em produção.
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
# Com false, o cadastro de novos usuários responde 403 e o link some do login.
REGISTRATION_ENABLED=true

# Usuário de teste do ambiente de desenvolvimento, criado por:
#   docker compose exec backend yarn seed
SEED_USER_NOME="Usuário Teste"
SEED_USER_EMAIL=teste@moedy.dev
SEED_USER_SENHA=teste12345

# Sugestão de categorias por IA (opcional). Vazio = recurso desligado.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# --- Frontend (só no compose de desenvolvimento) ---
# true se o hot reload não perceber mudanças nos arquivos (comum no Windows).
VITE_USE_POLLING=false
