generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Valores monetários (saldoInicial, valor, valorLimite) são sempre guardados em centavos (Int).

enum AccountType {
  CORRENTE
  POUPANCA
  CARTAO
  DINHEIRO
}

enum AccountOrigin {
  MANUAL
  IMPORT
  PLUGGY
}

enum TransactionType {
  DESPESA
  RECEITA
}

enum CategoriaOrigem {
  MANUAL
  REGRA
  MEMORIA
  IA
}

enum NotificationType {
  ORCAMENTO_ATENCAO
  ORCAMENTO_ESTOURADO
  ORCAMENTO_PROJECAO
  DESPESA_ATIPICA
  RECORRENTE_NOVA
  RECORRENTE_VALOR
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  // Nula em contas criadas pelo login com Google, que entram sem senha
  senha     String?
  // Identificador da conta Google (claim "sub" do token), quando o usuário já entrou com Google
  googleId  String?  @unique
  createdAt DateTime @default(now())

  accounts      Account[]
  categories    Category[]
  budgets       Budget[]
  categoryRules CategoryRule[]
  notifications Notification[]
  categoryMemories CategoryMemory[]
  // Uso da IA na importação: desligado por padrão; iaConsentidaEm guarda quando o usuário aceitou o aviso
  usarIaImportacao Boolean   @default(false)
  iaConsentidaEm   DateTime?
  // Onboarding: quando o usuário concluiu ou pulou o tour guiado, e quando ocultou o checklist de
  // primeiros passos do Painel. Nulos = ainda não; o app oferece o tour no primeiro acesso.
  onboardingTourEm         DateTime?
  primeirosPassosOcultosEm DateTime?
}

model Account {
  id           String        @id @default(uuid())
  userId       String
  nome         String
  tipo         AccountType
  saldoInicial Int           @default(0)
  origem       AccountOrigin @default(MANUAL)
  externalId   String?
  createdAt    DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Category {
  id     String          @id @default(uuid())
  userId String
  nome   String
  cor    String
  icone  String
  tipo   TransactionType

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  rules        CategoryRule[]
  categoryMemories CategoryMemory[]

  @@unique([userId, nome, tipo])
}

model Transaction {
  id         String          @id @default(uuid())
  accountId  String
  categoryId String?
  descricao  String
  valor      Int
  data       DateTime
  tipo       TransactionType
  externalId String?
  // Transferências entre contas próprias e pagamentos de fatura: movimentam o saldo da conta,
  // mas não são receita nem despesa de verdade, então ficam fora dos relatórios.
  ignorarNosRelatorios Boolean @default(false)
  // De onde veio a categoria: escolha manual, regra, memória de escolhas anteriores ou sugestão da IA
  origemCategoria CategoriaOrigem @default(MANUAL)
  createdAt  DateTime        @default(now())

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Evita duplicatas na importação (vários externalId nulos não conflitam).
  @@unique([accountId, externalId])
  @@index([accountId, data])
  @@index([categoryId])
}

model Budget {
  id          String @id @default(uuid())
  userId      String
  categoryId  String
  valorLimite Int
  mes         Int
  ano         Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, mes, ano])
}

model CategoryRule {
  id           String @id @default(uuid())
  userId       String
  palavraChave String
  categoryId   String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  tipo      NotificationType
  titulo    String
  mensagem  String
  // Caminho da página relacionada no app (ex.: /orcamentos?mes=2026-10)
  link      String?
  lida      Boolean          @default(false)
  // Alertas excluídos pelo usuário ficam ocultos em vez de apagados: a chave continua ocupada,
  // então o mesmo alerta não é recriado na próxima verificação
  excluida  Boolean          @default(false)
  // Identifica o motivo do alerta (ex.: "orcamento:<id>:estourado"), para ele nunca se repetir
  chave     String
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chave])
  @@index([userId, excluida, lida, createdAt])
}

// Descrição (normalizada) → categoria que o usuário escolheu da última vez. Sem repetir, por tipo.
model CategoryMemory {
  id         String          @id @default(uuid())
  userId     String
  chave      String
  tipo       TransactionType
  categoryId String
  updatedAt  DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, chave, tipo])
}
