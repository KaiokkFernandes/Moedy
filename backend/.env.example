PORT=3333
DATABASE_URL="postgresql://moedy:moedy@localhost:5432/moedy?schema=public"
JWT_SECRET="troque-este-segredo-em-producao"

# Usuário de teste criado pelo `yarn seed`
SEED_USER_NOME="Usuário Teste"
SEED_USER_EMAIL="teste@moedy.dev"
SEED_USER_SENHA="teste12345"

# Sugestão de categorias por IA (opcional). Sem a chave, a importação segue só com regras e memória.
# Nunca commite a chave real: o .env já está no .gitignore.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_TIMEOUT_MS=20000
AI_MAX_TRANSACTIONS=500
