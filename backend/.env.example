# Copie para .env e ajuste. O servidor não sobe se uma variável obrigatória faltar.
NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://moedy:moedy@localhost:5432/moedy?schema=public"
# Só com pooler na frente do banco (Neon na Vercel): URL direta, usada pelas migrações.
# DATABASE_URL_UNPOOLED=
# Obrigatório, com no mínimo 32 caracteres. Gere o seu com: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"

# Outras origens que podem chamar a API, separadas por vírgula. O próprio domínio do app é sempre
# aceito; só é preciso quando o frontend fica em outro endereço (como o Vite em desenvolvimento).
CORS_ORIGIN="http://localhost:5173"
# Redis dos limites de tentativas (login, cadastro, IA). Obrigatório na Vercel; sem ele, em memória.
# REDIS_URL=
# Com false, o cadastro de novos usuários responde 403 e o link some do login.
REGISTRATION_ENABLED=true

# Usuário de teste criado pelo `yarn seed`
SEED_USER_NOME="Usuário Teste"
SEED_USER_EMAIL="teste@moedy.dev"
SEED_USER_SENHA="teste12345"

# Login com Google (opcional): Client ID do OAuth criado no Google Cloud. Sem ele, o botão não aparece.
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Sugestão de categorias por IA (opcional). Sem a chave, a importação segue só com regras e memória.
# Nunca commite a chave real: o .env já está no .gitignore.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_TIMEOUT_MS=20000
AI_MAX_TRANSACTIONS=500
