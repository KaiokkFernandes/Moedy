# Copie para .env.local se precisar apontar para outro backend.
#
# Endereço do backend, sem /api no fim, SÓ se ele ficar em outro domínio. Ex.:
#   VITE_API_URL=https://api.meudominio.com
# Na Vercel (frontend e backend no mesmo projeto) e em desenvolvimento, deixe vazio: as chamadas
# vão para /api no mesmo endereço (em desenvolvimento, o proxy do Vite leva para localhost:3333).
VITE_API_URL=
