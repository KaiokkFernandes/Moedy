# Copie para .env.local se precisar apontar para outro backend.
#
# Endereço do backend, sem /api no fim. Em produção (Vercel), é a URL do serviço no Render:
#   VITE_API_URL=https://seu-backend.onrender.com
# Em desenvolvimento, deixe vazio: o proxy do Vite encaminha /api para http://localhost:3333.
VITE_API_URL=
