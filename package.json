{
  "name": "financas",
  "private": true,
  "version": "0.1.0",
  "description": "App de finanças pessoais (monorepo frontend + backend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"yarn workspace backend dev\" \"yarn workspace frontend dev\"",
    "dev:backend": "yarn workspace backend dev",
    "dev:frontend": "yarn workspace frontend dev",
    "build": "yarn workspace backend build && yarn workspace frontend build",
    "prisma:migrate": "yarn workspace backend prisma:migrate",
    "prisma:studio": "yarn workspace backend prisma:studio",
    "seed": "yarn workspace backend seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "packageManager": "yarn@4.18.1",
  "dependenciesMeta": {
    "@prisma/engines": {
      "built": true
    },
    "better-sqlite3": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "prisma": {
      "built": true
    }
  }
}
